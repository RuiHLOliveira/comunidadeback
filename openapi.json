{
  "openapi": "3.0.0",
  "info": {
    "title": "API Comunidade Alunos",
    "description": "Documentação completa das APIs do sistema de alunos e comunidade, incluindo o sistema de perguntas dinâmicas com histórico de respostas.",
    "version": "1.1.0"
  },
  "servers": [
    {
      "url": "/api",
      "description": "Servidor Principal"
    }
  ],
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    },
    "schemas": {
      "User": {
        "type": "object",
        "properties": {
          "id": { "type": "integer" },
          "email": { "type": "string" },
          "nome": { "type": "string" },
          "apelido": { "type": "string" },
          "informacoes": {
            "type": "object",
            "additionalProperties": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "data": { "type": "string", "example": "2026-04-14 21:09:03" },
                  "resposta": { "type": "string" }
                }
              }
            },
            "example": {
              "status_atual": [
                { "data": "2026-04-14 21:09:03", "resposta": "Júnior empregado" },
                { "data": "2026-03-01 10:00:00", "resposta": "Estagiário" }
              ],
              "nome_completo": [
                { "data": "2026-04-14 21:09:03", "resposta": "João Silva" }
              ]
            }
          }
        }
      },
      "Pergunta": {
        "type": "object",
        "properties": {
          "key": { "type": "string" },
          "texto": { "type": "string" },
          "tipo": { "type": "string", "enum": ["texto", "select"] },
          "max_length": { "type": "integer", "nullable": true },
          "pagina": { "type": "integer", "description": "Número da página da pergunta (1-4)" },
          "opcoes": { 
            "type": "array", 
            "items": { "type": "string" },
            "nullable": true 
          }
        }
      }
    }
  },
  "paths": {
    "/auth/login": {
      "post": {
        "tags": ["Auth"],
        "summary": "Realiza o login do usuário",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "email": { "type": "string", "example": "user@example.com" },
                  "password": { "type": "string", "example": "123456" }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Login realizado com sucesso",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "token": { "type": "string" },
                    "refreshToken": { "type": "string" },
                    "userData": { "type": "object" }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/auth/register": {
      "post": {
        "tags": ["Auth"],
        "summary": "Registra um novo usuário",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "email": { "type": "string" },
                  "password": { "type": "string" },
                  "repeatPassword": { "type": "string" },
                  "invitationToken": { "type": "string" }
                },
                "example": {
                  "email": "novo@aluno.com",
                  "password": "senha",
                  "repeatPassword": "senha",
                  "invitationToken": "TOKEN123"
                }
              }
            }
          }
        },
        "responses": {
          "201": { "description": "Usuário criado" }
        }
      }
    },
    "/perguntas": {
      "get": {
        "tags": ["Perguntas"],
        "summary": "Lista todas as perguntas e páginas disponíveis no sistema",
        "security": [{ "bearerAuth": [] }],
        "responses": {
          "200": {
            "description": "Objeto contendo a lista de páginas e a lista de perguntas",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "paginas": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "id": { "type": "integer" },
                          "titulo": { "type": "string" }
                        }
                      }
                    },
                    "perguntas": {
                      "type": "array",
                      "items": { "$ref": "#/components/schemas/Pergunta" }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/perguntas/respostas": {
      "get": {
        "tags": ["Perguntas"],
        "summary": "Obtém apenas a resposta mais recente de cada pergunta do usuário autenticado",
        "security": [{ "bearerAuth": [] }],
        "responses": {
          "200": {
            "description": "Respostas mais recentes retornadas com sucesso",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": {
                    "type": "object",
                    "properties": {
                      "data": { "type": "string" },
                      "resposta": { "type": "string" }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/perguntas/responder": {
      "post": {
        "tags": ["Perguntas"],
        "summary": "Registra múltiplas respostas (Bulk) mantendo histórico",
        "description": "Envia um objeto chave-valor. Novas respostas são adicionadas ao topo do histórico de cada pergunta.",
        "security": [{ "bearerAuth": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": { "type": "string" },
                "example": {
                  "status_atual": "Júnior empregado",
                  "horas_dedicacao": "5h–10h",
                  "github_portfolio": "https://github.com/usuario"
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Respostas registradas com sucesso. Retorna o usuário com o histórico atualizado.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "message": { "type": "string" },
                    "user": { "$ref": "#/components/schemas/User" }
                  }
                }
              }
            }
          },
          "400": { "description": "Erro de validação (ex: tamanho de texto excedido ou pergunta inexistente)" }
        }
      }
    },
    "/posts": {
      "get": { "tags": ["Comunidade"], "summary": "Lista posts", "security": [{ "bearerAuth": [] }], "responses": { "200": { "description": "OK" } } },
      "post": { "tags": ["Comunidade"], "summary": "Cria post", "security": [{ "bearerAuth": [] }], "responses": { "201": { "description": "Criado" } } }
    }
  }
}
